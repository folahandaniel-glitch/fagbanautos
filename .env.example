# ── Database (PostgreSQL). Use the POOLED url at runtime and the DIRECT url for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fagdan?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/fagdan?schema=public"

# ── Application
APPLICATION_URL="http://localhost:3000"
AUTH_SECRET="generate-with: openssl rand -base64 48"
SETTINGS_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# ── Paystack (may instead be entered in Admin > Settings > Paystack; env takes precedence)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# ── Email (SMTP or provider)
EMAIL_FROM="FAGDAN <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── File storage (S3-compatible / Vercel Blob / Cloudinary). Local ./uploads is used only in development.
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── WhatsApp Business Cloud API (optional)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Rate limiting (optional Upstash; in-memory fallback in development)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cron protection (Vercel Cron sends this as a Bearer token)
CRON_SECRET="generate-with: openssl rand -hex 24"

# ── Seeding. Demo seed is refused when NODE_ENV=production unless ALLOW_DEMO_SEED=true is set deliberately.
ALLOW_DEMO_SEED="false"
